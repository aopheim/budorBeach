@page
@using rpiDaemon.DateTimeHelpers
@using budorWeb.Helpers
@using global::Shared.Azure
@model budorWeb.Pages.ImagesModel
@{
}

@*<h3>Vis bilder fra </h3>
<select class="form-select" id="dateSelector" aria-label="Se bilder fra...">
    <option value="30.5.21">30.5.2021</option>
</select>*@

<div class="row">
    @foreach (var blob in @Model.ImageBlobsForDay)
    {
        <div class="col-md-6">
            <div class="card my-3">
                <a href="@blob.GetUrlForBlob(Model.ContainerClient)">
                    <img class="card-img-top" src="@blob.GetUrlForBlob(Model.ContainerClient)" alt="@blob.Name">
                </a>
                <div class="card-body">
                    <h4 class="card-text">@DateTimeParser.GetLocalDateTimeAsString(DateTimeParser.GetDateTimeFromFolderAndFileName(blob.Name))</h4>
                </div>
            </div>
        </div>
    }
</div>
