@page
@using global::Shared.DateTimeHelpers
@model budorWeb.Pages.ImagesModel
@{
}

@*<h3>Vis bilder fra </h3>
<select class="form-select" id="dateSelector" aria-label="Se bilder fra...">
    <option value="30.5.21">30.5.2021</option>
</select>*@

<div class="row">
    @foreach (var image in Model.ImagesForDay)
    {
        <div class="col-md-6">
            <div class="card my-3">
                <a href="@image.ImageUrl">
                    <img class="card-img-top" src="@image.ThumbnailUrl" alt="@image.Name">
                </a>
                <div class="card-body">
                    <h4 class="card-text">@DateTimeParser.GetLocalDateTimeAsString(DateTimeParser.GetDateTimeFromFolderAndFileName(image.Name))</h4>
                </div>
            </div>
        </div>
    }
</div>
</div>