@page "{id:?}"
@using rpiDaemon.DateTimeHelpers
@model budorWeb.Pages.Species.Species

@if (Model.SpeciesId == null)
{
    <button onclick="location.href = '@Url.Page("Index", "OnGet", new { fromDate = DateTime.UtcNow.AddHours(-24), toDate = DateTime.UtcNow })'">Siste 24 timer</button>
    <button onclick="location.href = '@Url.Page("Index", "OnGet", new { fromDate = DateTime.UtcNow.AddDays(-7), toDate = DateTime.UtcNow })'">Siste 7 dager</button>
    <button onclick="location.href = '@Url.Page("Index", "OnGet", new { fromDate = DateTime.UtcNow.AddDays(-30), toDate = DateTime.UtcNow })'">Siste 30 dager</button>
    <button onclick="location.href = '@Url.Page("Index")'">Gjennom tidene</button>


    @if (!Model.AllSpeciesCount.Any())
    {
        <p>Ingen gjenkjenninger funnet i valgt tidsperiode</p>
    }

    @foreach (var species in Model.AllSpeciesCount)
    {
        <a asp-page="index/" asp-route-id="@species.SpeciesId">
            <p>@species.NorwegianName: @species.TotalCount</p>
        </a>
    }
}
else
{
    <h1>@Model.NorwegianSpeciesName</h1>
    <div class="row mt-3">
        <div class="col-lg-6">
            <div class="card">
                <h5 class="card-header">Beste gjenkjenninger</h5>
                <div class="card-body">
                    @foreach (var rec in Model.HighestRecognitionConfidences)
                    {
                        var confidenceInPercent = (int)Math.Round(rec.Confidence * 100, MidpointRounding.AwayFromZero);
                        <div class="d-flex ">
                            <div class="row align-items-end">
                                <div class="col-3">
                                    <div class="progress">
                                        <div class="progress-bar " role="progressbar" style="width: @confidenceInPercent%; background-color:  grey;" aria-valuenow="@confidenceInPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <p>@confidenceInPercent%</p>
                                </div>
                                <div class="col-9">
                                    <audio controls loop preload="none" src="@rec.RecordingUrl"></audio>
                                </div>
                            </div>
                        </div>
                        <p class="fst-italic">@DateTimeParser.GetLocalDateTimeAsString(rec.RecognizedAtUtc)</p>
                        <hr class="mt-4 mb-4"/>
                    }
                </div>
            </div>

        </div>
    </div>
}