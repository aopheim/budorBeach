@page
@model budorWeb.Pages.Admin

@{
    Layout = null;
}

<form asp-page-handler="convertImages" method="post">
    <button >Konverter jpg-bilder til WebP-format</button>
</form>

<form asp-page-handler="migrateRecognitions" method="post">
    <button>Konverter gjenkjenninger til å inkludere EBirdSpeciesId</button>
</form>

<div>
    <p>Bilde-intervall i minutter: @Model.PictureIntervalInMinutes</p>
    <p>Minimum konfidens for arts-gjenkjenning: @Model.SpeciesRecognitionConfidence</p>
</div>