@page
@model budorWeb.Pages.Admin

@{
    Layout = null;
}

<form asp-page-handler="convertImages" method="post">
    <button >Konverter jpg-bilder til WebP-format</button>
</form>

<form asp-page-handler="migrateRecognitions" method="post">
    <button>Konverter gjenkjenninger til å inkludere EBirdSpeciesId</button>
</form>

<form asp-page-handler="setRpiDaemonSettings" method="post">
    <div class="mb-1">
        <label  class="form-label">Bilde-intervall i minutter</label>
        <input asp-for="PictureIntervalInMinutes" min="0" type="number" class="form-control" id="pictureIntervalInMinutes" value="@Model.PictureIntervalInMinutes"/>
    </div>
    <div>
        <label  class="form-label">Minimum konfidens for arts-gjenkjenning</label>
        <input asp-for="SpeciesRecognitionConfidence" min="0.1" max="1.0" step="0.05" type="number" class="form-control" id="speciesRecognitionConfidence" value="@Model.SpeciesRecognitionConfidence"/>
    </div>
    <button type="submit" class="btn btn-primary">Oppdater</button>
</form>