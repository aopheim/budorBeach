                            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls3" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-1"></div>
                </div>

                <hr class="my-4" />

                <h4 id="@NewsFeedService.GetNewsFeedEntries()[4].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[4].Date) - @NewsFeedService.GetNewsFeedEntries()[4].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[4].Body</p>

                <hr class="my-4" />

                <h4 id="@NewsFeedService.GetNewsFeedEntries()[5].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[5].Date) - @NewsFeedService.GetNewsFeedEntries()[5].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[5].Body</p>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <img src="@NewsFeedService.GetNewsFeedEntries()[5].ImageUrls[0]" class="img-fluid" />
                    </div>
                    <div class="col-2"></div>
                </div>

                <hr class="my-4" />

                <h4 id="@NewsFeedService.GetNewsFeedEntries()[6].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[6].Date) - @NewsFeedService.GetNewsFeedEntries()[6].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[6].Body</p>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <div id="carouselExampleControls4" class="carousel slide" data-interval="false">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="@NewsFeedService.GetNewsFeedEntries()[6].ImageUrls[0]" class="d-block w-100" alt="...">
