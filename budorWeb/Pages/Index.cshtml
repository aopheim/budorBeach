@page
@using rpiDaemon.DateTimeHelpers
@using System.Text.Json
@using Azure.Storage.Blobs.Models
@using budorWeb.Services
@using global::Shared.Azure
@using global::Shared.Models
@using global::Shared.PiCameraSettings
@model BudorBeachModel
@{
    ViewData["Title"] = "Budor Beach";
}

@section Styles {
    <link href="@Url.Content("~/css/index.css")" rel="stylesheet" type="text/css" />
}
<div class="container my-3">
    <div class="row">
        <div class="col">
            <p>Sist oppdatert</p>
            <p id="lastUpdatedAt">@DateTimeParser.GetLocalDateTimeAsString(Model.LatestSensorReadingModel?.MeasuredAtUtc)</p>
            <div class="alert-success">
                <i class=""></i>
                <p>18.06.2021: Sjekk ut siste fuglekassenytt nederst på siden!</p>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-4">
            <div class="text-center">
                <i class="fa fa-thermometer-three-quarters"></i>
                <p id="temperatureInDegreesC">@Math.Round(Model.LatestSensorReadingModel?.TemperatureInDegreesC ?? default, 1)°C</p>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="text-center">
                <i class="fa fa-humidity"></i>
                <p id="relativeHumidityInPercent">@Math.Round(Model.LatestSensorReadingModel?.RelativeHumidityInPercent ?? default, 1)%</p>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="text-center">
                <i class="fa fa-humidity"></i>
                <p id="pressureInhPa">@Math.Round(Model.LatestSensorReadingModel?.PressureInhPa ?? default, 1)hPa</p>
            </div>
        </div>
        @{
            const int last12 = 12;
            const int lastDay = 24;
            const int lastThreeDays = 24 * 3;
            const int lastSevenDays = 24 * 7;
            const int lastMonth = 24 * 30;
            const int lastThreeMonths = 24 * 30 * 3;
            const int lastSixMonths = 24 * 30 * 6;
            const int lastYear = 24 * 30 * 12;
        }
        <div class="col-sm-6 col-lg-2">
            <select class="form-select" id="chartDropDown" aria-label="Se data fra siste...">
                <option value="@last12" selected="selected">Siste 12 timer</option>
                <option value="@lastDay">Siste døgn</option>
                <option value="@lastThreeDays">Siste tre dager</option>
                <option value="@lastSevenDays">Siste uke</option>
                <option value="@lastMonth">Siste måned</option>
                <option value="@lastThreeMonths">Siste 3 måneder</option>
                <option value="@lastSixMonths">Siste 6 måneder</option>
                <option value="@lastYear">Siste år</option>
            </select>
        </div>
        <div class="col-sm-12">
            <div class="card-body">
                <canvas id="tempChart"></canvas>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card-body">
                <canvas id="humidityChart"></canvas>
            </div>
        </div><div class="col-sm-6">
            <div class="card-body">
                <canvas id="pressureChart"></canvas>
            </div>
        </div>
    </div>

    <h2>De 5 siste bildene</h2>
    <div class="row">
        @foreach (var blob in @Model?.LatestImages ?? new List<BlobItem>())
        {
            <div class="col-md-6">
                <div class="card my-3">
                    <a href="@blob.GetUrlForBlob(Model.ContainerClient)">
                        <img class="card-img-top" src="@blob.GetUrlForBlob(Model.ContainerClient)" alt="@blob.Name">
                    </a>
                    <div class="card-body">
                        <h4 class="card-text">@DateTimeParser.GetLocalDateTimeAsString(DateTimeParser.GetDateTimeFromFolderAndFileName(blob.Name))</h4>
                    </div>
                </div>
            </div>
        }
    </div>
    <a href="images"><h2>Til dagens bildegalleri</h2></a>
    <br/>
    <br/>
    <br/>
    <h2>Siste fuglekassenytt</h2>
    <div class="row">
        <div class="col-4">
                <nav id="navbar-example3" class="navbar navbar-light bg-light flex-column align-items-stretch">
                    <nav class="nav nav-pills flex-column">
                        @foreach (var entry in NewsFeedService.GetNewsFeedEntries())
                        {
                            <a class="nav-link" href="#@entry.Id">@DateTimeParser.GetLocalDateAsString(entry.Date) - @entry.Header</a>
                        }
                    </nav>
                </nav>

        </div>
        <div class="col-8">
            <div data-bs-spy="scroll" data-bs-target="#navbar-example3" data-bs-offset="0" tabindex="0" style="height: 400px; overflow-y: scroll">
                <h4 id="@NewsFeedService.GetNewsFeedEntries()[0].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[0].Date) - @NewsFeedService.GetNewsFeedEntries()[0].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[0].Body</p>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <div id="carouselExampleControls" class="carousel slide" data-interval="false">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img src="@NewsFeedService.GetNewsFeedEntries()[0].ImageUrls[0]" class="d-block w-100" alt="...">
                                </div>
                                <div class="carousel-item">
                                    <img src="@NewsFeedService.GetNewsFeedEntries()[0].ImageUrls[1]" class="d-block w-100" alt="...">
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-1"></div>
                </div>

                <hr class="my-4" />

                <h4 id="@NewsFeedService.GetNewsFeedEntries()[1].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[1].Date) - @NewsFeedService.GetNewsFeedEntries()[1].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[1].Body</p>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
