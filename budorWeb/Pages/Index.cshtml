                        </div>
                    </div>
                    <div class="col-1"></div>
                </div>

                <hr class="my-4" />

                <h4 id="@NewsFeedService.GetNewsFeedEntries()[3].Id">@DateTimeParser.GetLocalDateAsString(@NewsFeedService.GetNewsFeedEntries()[3].Date) - @NewsFeedService.GetNewsFeedEntries()[3].Header</h4>
                <p>@NewsFeedService.GetNewsFeedEntries()[3].Body</p>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
